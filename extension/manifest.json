{
  "manifest_version": 3,
  "name": "Live Japanese Captions | Edge & Chrome",
  "short_name": "Live JP Captions",
  "version": "0.4.1",
  "description": "Add Japanese subtitles to live videos using browser-local Whisper ASR and Translator API, no Python server.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "storage"],
  "host_permissions": ["https://huggingface.co/*", "https://*.huggingface.co/*", "https://*.xethub.hf.co/*", "https://*.hf.co/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "日本語字幕を開始 / 停止"},
  "options_page": "options.html",
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
